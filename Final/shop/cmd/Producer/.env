# Kafka broker (internal listener)
BROKER=kafka-1st-1:1092

# Schema Registry URL
SCHEMA_REGISTRY_URL=http://schema-registry-1st:8081

# SASL credentials
SASL_USERNAME=admin
SASL_PASSWORD=admin-secret

# Path to CA certificate for TLS
CA_PATH=/usr/local/bin/ca.crt

# Kafka topic
TOPIC=product

# Path to input JSON file
JSON_FILE_PATH=/home/appuser/data/products_2.json