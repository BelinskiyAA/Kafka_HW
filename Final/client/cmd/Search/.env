ANALYTICS_SCHEMA_SUBJECT=analytics.events-value
# Подключение к PostgreSQL (обязательно)
DATABASE_URL=postgres://shop:shop@postgres:5432/shop?sslmode=disable

# Kafka (для отправки аналитики, если analytics.NewService() использует)
BROKER=kafka-1st-1:1092
SCHEMA_REGISTRY_URL=http://schema-registry-1st:8081
SASL_USERNAME=admin
SASL_PASSWORD=admin-secret
CA_PATH=/usr/local/bin/ca.crt

# Топик для событий поиска (если используется)
# SEARCH_TOPIC=search-events   # уточните в коде analytics